{
  "name": "elf-orchestrator",
  "version": "1.0.0",
  "description": "ELF orchestrator runtime: workflow state, verification, and thin host adapters.",
  "license": "MIT",
  "author": "Jhonatan",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhowtkd/speckit-driven.git"
  },
  "homepage": "https://github.com/jhowtkd/speckit-driven#readme",
  "bugs": {
    "url": "https://github.com/jhowtkd/speckit-driven/issues"
  },
  "type": "commonjs",
  "keywords": [
    "elf",
    "orchestrator",
    "cli",
    "mcp",
    "cursor",
    "codex"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
